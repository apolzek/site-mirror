{
  "name": "site-mirror",
  "version": "0.1.0",
  "description": "Site Mirror: a Chrome extension that records a website (HTML, CSS, JS, images, fonts and the data its scripts load) and replays it offline exactly as it was.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apolzek/site-mirror.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:test": "node scripts/build.mjs --test",
    "watch": "node scripts/build.mjs --watch",
    "package": "npm run build && node scripts/package.mjs",
    "test": "node --test \"test/unit/**/*.test.js\"",
    "test:e2e": "playwright test",
    "icons": "node scripts/icons.mjs",
    "fixture": "node test/e2e/sites.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2"
  }
}
